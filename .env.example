# Production Docker/Portainer server example only. For Windows development use .env.windows.example.
ONTRACK_DATABASE_URL=postgresql+psycopg://ontrack:change-me@db:5432/ontrack
ONTRACK_SECRET_KEY=replace-with-at-least-32-random-characters
ONTRACK_CREDENTIAL_PEPPER=replace-with-a-separate-random-secret
ONTRACK_COOKIE_SECURE=true
ONTRACK_ALLOWED_HOSTS=localhost,127.0.0.1
ONTRACK_TRUSTED_PROXY_CIDRS=127.0.0.1/32
ONTRACK_TRUSTED_DEVICE_DAYS_STANDARD=90
ONTRACK_TRUSTED_DEVICE_DAYS_ELEVATED=14
ONTRACK_TRUSTED_DEVICE_LIMIT=10
ONTRACK_PUBLIC_SIGNUP_ENABLED=false
ONTRACK_HOST_PORT=8080
ONTRACK_APP_VERSION=0.2.0
ONTRACK_BUILD_ID=
POSTGRES_DB=ontrack
POSTGRES_USER=ontrack
POSTGRES_PASSWORD=change-me
TZ=Pacific/Auckland
