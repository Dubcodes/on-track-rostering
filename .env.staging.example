# Private staging only. Supply distinct values through the staging Portainer stack.
STAGING_POSTGRES_DB=ontrack_staging
STAGING_POSTGRES_USER=ontrack_staging
STAGING_POSTGRES_PASSWORD=replace-with-a-staging-only-database-password
STAGING_ONTRACK_SECRET_KEY=replace-with-a-staging-only-secret-of-at-least-32-characters
STAGING_ONTRACK_CREDENTIAL_PEPPER=replace-with-a-separate-staging-only-pepper
STAGING_ONTRACK_ALLOWED_HOSTS=roster-staging.example.com
STAGING_ONTRACK_TRUSTED_PROXY_CIDRS=172.20.0.0/24
STAGING_ONTRACK_BUILD_ID=replace-with-exact-qualified-git-sha
STAGING_ONTRACK_WEBAUTHN_RP_ID=roster-staging.example.com
STAGING_ONTRACK_WEBAUTHN_ORIGIN=https://roster-staging.example.com
TZ=Pacific/Auckland
